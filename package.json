{
  "name": "opencode-sidebar-tui",
  "displayName": "ULW Sidebar Terminal",
  "description": "A fast native shell terminal in the VS Code secondary sidebar.",
  "version": "1.12.4",
  "publisher": "islee23520",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "sidebar",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/islee23520/ulwcode.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "ulwContainer",
          "title": "ULW",
          "icon": "resources/ulwcode-sidebar.svg"
        }
      ]
    },
    "views": {
      "ulwContainer": [
        {
          "id": "ulw",
          "name": "Terminal",
          "type": "webview",
          "icon": "resources/ulwcode-sidebar.svg"
        }
      ]
    },
    "configuration": {
      "title": "ULW Terminal",
      "properties": {
        "ulw.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 72,
          "description": "Terminal font size."
        },
        "ulw.fontFamily": {
          "type": "string",
          "default": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', Menlo, monospace",
          "description": "Terminal font family."
        },
        "ulw.cursorBlink": {
          "type": "boolean",
          "default": true,
          "description": "Whether the terminal cursor blinks."
        },
        "ulw.cursorStyle": {
          "type": "string",
          "enum": [
            "block",
            "underline",
            "bar"
          ],
          "default": "block",
          "description": "Terminal cursor style."
        },
        "ulw.scrollback": {
          "type": "number",
          "default": 10000,
          "minimum": 0,
          "maximum": 100000,
          "description": "Number of terminal scrollback lines."
        },
        "ulw.shellPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional shell executable. Empty uses the VS Code or system default shell."
        },
        "ulw.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Arguments passed to the shell executable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && webpack",
    "compile:e2e": "tsc -p tsconfig.e2e.json",
    "watch": "webpack --watch",
    "package": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "test": "vitest run",
    "pretest:e2e": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && npm run compile && npm run compile:e2e",
    "test:e2e": "vscode-test",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build-and-install": "npx @vscode/vsce package -o build/extension.vsix && code --install-extension build/extension.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "@types/vscode": "^1.106.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.56.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.5",
    "prettier": "^3.7.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.0"
  },
  "dependencies": {
    "node-pty": "^1.2.0-beta.11"
  }
}
